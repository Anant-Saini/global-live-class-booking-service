    {
      "name": "/api/v1/bookings",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const baseUrl = pm.globals.get(\"base_url\") || pm.environment.get(\"base_url\") || pm.collectionVariables.get(\"base_url\");",
              "",
              "const requestBody = JSON.stringify({ offeringId: 6 });",
              "",
              "const requestOne = {",
              "    url: baseUrl + \"/api/v1/bookings\",",
              "    method: \"POST\",",
              "    header: {",
              "        \"Content-Type\": \"application/json\",",
              "        \"X-Parent-Id\": \"3\"",
              "    },",
              "    body: {",
              "        mode: \"raw\",",
              "        raw: requestBody",
              "    }",
              "};",
              "",
              "const requestTwo = {",
              "    url: baseUrl + \"/api/v1/bookings\",",
              "    method: \"POST\",",
              "    header: {",
              "        \"Content-Type\": \"application/json\",",
              "        \"X-Parent-Id\": \"5\"",
              "    },",
              "    body: {",
              "        mode: \"raw\",",
              "        raw: requestBody",
              "    }",
              "};",
              "",
              "pm.sendRequest(requestOne, function (err, res) {",
              "    if (err) {",
              "        console.error(\"Request with X-Parent-Id: 3 failed:\", err);",
              "    } else {",
              "        console.log(\"Response for X-Parent-Id: 3 →\", res.status, res.json());",
              "    }",
              "});",
              "",
              "pm.sendRequest(requestTwo, function (err, res) {",
              "    if (err) {",
              "        console.error(\"Request with X-Parent-Id: 5 failed:\", err);",
              "    } else {",
              "        console.log(\"Response for X-Parent-Id: 5 →\", res.status, res.json());",
              "    }",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "X-Parent-Id",
            "value": "5",
            "type": "text",
            "disabled": true
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"offeringId\": 6}",
          "options": {
